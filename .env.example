# Copy this file to ".env" and fill in real values.
# Never commit the real ".env" file to source control.

# Flask secret key - used to sign session cookies. Use any long random string.
SECRET_KEY=change-this-to-a-long-random-secret-string

# SQLite database URL (default is fine for the academic demo)
DATABASE_URL=sqlite:///instance/app.db

# ---- LLM CONFIGURATION ----
# If LLM_API_KEY is left empty, the application automatically runs in DEMO MODE:
# the chatbot, business plan generator, and market analysis will use built-in
# template-based responses instead of calling an external LLM API.
#
# Supported provider styles (set LLM_PROVIDER accordingly):
#   "openai"     -> OpenAI-compatible Chat Completions API (also works with many
#                    hosted Mistral / LLaMA endpoints that mimic the OpenAI schema)
#   "none"       -> force Demo Mode even if a key is present
LLM_PROVIDER=none
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=True
